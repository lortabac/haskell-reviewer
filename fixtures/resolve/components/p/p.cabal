cabal-version: 3.0
name: p
version: 1

library
  hs-source-dirs: src
  exposed-modules: P.Api
  other-modules: Helper Paths_p
  autogen-modules: Paths_p
  build-depends: base, p:internal
  default-language: GHC2021

library internal
  hs-source-dirs: internal
  exposed-modules: P.Internal
  build-depends: base
  default-language: GHC2021

test-suite spec
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  other-modules: Helper
  build-depends: base, p
  default-language: GHC2021
