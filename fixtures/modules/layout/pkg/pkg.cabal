cabal-version: 3.0
name:          pkg
version:       0.1.0

library
  hs-source-dirs:  src gen
  exposed-modules: Foo Lexer Parser Lit
  signatures:      Sig
  other-modules:   Paths_pkg Gone
  autogen-modules: Paths_pkg

executable app
  hs-source-dirs: app
  main-is:        ../shared/Main.hs
  other-modules:  Main

executable c-main
  hs-source-dirs: app
  main-is:        main.c

test-suite spec
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  ghc-options:    -F -pgmF hspec-discover

test-suite docs
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        README.lhs
  ghc-options:    -pgmL markdown-unlit
