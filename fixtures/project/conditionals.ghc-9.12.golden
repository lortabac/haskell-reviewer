source: *.cabal in ROOT
package cond 1.0 (cond.cabal)
  flag dev = False (manual, default)
  flag fast = True (automatic, default)
  lib
    source dirs: src
    language: Haskell98
    build-depends: base
    modules: Cond (exposed), Cond.Linux (other), Cond.LinuxX86 (other)
    ghc-options: -O1
    cpp-options: -DX86, -DFAST
  lib:internal
    source dirs: internal
    language: Haskell2010
    modules: Internal (exposed)
  exe:tool
    source dirs: app
    language: Haskell98
    build-depends: base
    main-is: Main.hs
