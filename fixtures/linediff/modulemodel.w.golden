+-- | Text only, with nothing to highlight.
+textOnlyModule :: TextOnlyReason -> [ParseWarning] -> TextOnlyModule
+textOnlyModule reason warnings =
+  TextOnlyModule
+    { reason = reason,
+      warnings = warnings,
+      regions = noLineRegions
+    }
+
