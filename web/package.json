{
  "name": "haskell-reviewer-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:bundle": "node scripts/check-bundle.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@solidjs/router": "1.0.0",
    "cbor-x": "1.6.8",
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-plugin-solid": "0.18.1",
    "happy-dom": "21.0.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.5"
  }
}
