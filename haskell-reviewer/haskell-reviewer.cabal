    HaskellReviewer.Server.DiffFiles
    HaskellReviewer.Server.Events
    HaskellReviewer.Server.Listen
    HaskellReviewer.Server.Prefs
    HaskellReviewer.Server.Refs
    HaskellReviewer.Server.Reload
    HaskellReviewer.Server.Router
    HaskellReviewer.Server.Search
    HaskellReviewer.Server.Security
    HaskellReviewer.Server.TextSearch
    HaskellReviewer.Server.Wire
    HaskellReviewer.Server.Wire.Diff
