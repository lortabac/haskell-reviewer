cabal-version: 3.12
name:          haskell-reviewer
version:       0.1.0.0
synopsis:      Review Haskell code in the browser
-- GPL-2.0-only (the rename code is ported from git's diffcore). The
-- line diff (HaskellReviewer.Core.LineDiff*) stays LGPL-2.1-or-later.
-- See ../LICENSE (D-323).
license:       GPL-2.0-only
license-files:
  ../LICENSE
  ../LICENSE.LGPL-2.1

author:        Lorenzo Tabacchini
maintainer:    lortabac@gmail.com
copyright:     (c) 2026 Lorenzo Tabacchini
category:      Development
build-type:    Simple

-- See Note [Embedded bundle] in HaskellReviewer.Server.Assets. A new file
-- kind needs its glob here and its type in contentTypeFor, together.
extra-source-files:
  ../web/dist/assets/*.css
  ../web/dist/assets/*.js
  ../web/dist/index.html

common shared
  default-language:   GHC2024
  default-extensions:
    DuplicateRecordFields
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings

  ghc-options:
    -Wall -Wcompat -Wincomplete-record-updates -Wpartial-fields
    -Wredundant-constraints -Wunused-packages -Wmissing-export-lists

library
  import:          shared
  hs-source-dirs:  src

  -- Grouped by layer, lowest first. See Note [Layers] in
  -- HaskellReviewer.App.Run.
  exposed-modules:
