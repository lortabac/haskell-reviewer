cabal-version: 3.12
name:          haskell-reviewer
version:       0.1.0.0
synopsis:      Review Haskell code in the browser
license:       BSD-3-Clause
author:        Lorenzo Tabacchini
maintainer:    lortabac@gmail.com
copyright:     (c) 2026 Lorenzo Tabacchini
category:      Development
build-type:    Simple

-- See Note [Embedded bundle] in HaskellReviewer.Server.Assets. A new file
-- kind needs its glob here and its type in contentTypeFor, together.
extra-source-files:
  ../web/dist/assets/*.css
  ../web/dist/assets/*.js
  ../web/dist/index.html

common shared
  default-language:   GHC2024
  default-extensions:
    DuplicateRecordFields
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings

  ghc-options:
    -Wall -Wcompat -Wincomplete-record-updates -Wpartial-fields
    -Wredundant-constraints -Wunused-packages -Wmissing-export-lists

library
  import:          shared
  hs-source-dirs:  src

  -- Grouped by layer, lowest first. See Note [Layers] in
  -- HaskellReviewer.App.Run.
  exposed-modules:
    -- Core
    HaskellReviewer.Core.Address
    HaskellReviewer.Core.CabalCompat
    HaskellReviewer.Core.CabalFile
    HaskellReviewer.Core.FileContent
    HaskellReviewer.Core.FileList
    HaskellReviewer.Core.Git
    HaskellReviewer.Core.PackageGlob
    HaskellReviewer.Core.Project
    HaskellReviewer.Core.ProjectFile
    HaskellReviewer.Core.ProjectLoad
    HaskellReviewer.Core.RelPath
    HaskellReviewer.Core.Root

    -- Effects
    HaskellReviewer.Effects.Browser
    HaskellReviewer.Effects.Clock
    HaskellReviewer.Effects.FileSystem
    HaskellReviewer.Effects.Git
    HaskellReviewer.Effects.Helper
    HaskellReviewer.Effects.Log
    HaskellReviewer.Effects.PosixAt
    HaskellReviewer.Effects.Shutdown
    HaskellReviewer.Effects.Spawn
    HaskellReviewer.Effects.Trace

    -- Session
    HaskellReviewer.Session.Clients
    HaskellReviewer.Session.Project
    HaskellReviewer.Session.Snapshot

    -- Server
    HaskellReviewer.Server.Api
    HaskellReviewer.Server.Assets
    HaskellReviewer.Server.Events
    HaskellReviewer.Server.Listen
    HaskellReviewer.Server.Router
    HaskellReviewer.Server.Security
    HaskellReviewer.Server.Wire

    -- App
    HaskellReviewer.App.Cli
    HaskellReviewer.App.Run
    HaskellReviewer.App.Version

  -- See Note [Posix at] in HaskellReviewer.Effects.PosixAt.
  c-sources:       cbits/posix_at.c
  autogen-modules: PackageInfo_haskell_reviewer
  other-modules:   PackageInfo_haskell_reviewer
  build-depends:
    , aeson                 >=2.2    && <2.4
    , async                 >=2.2.5  && <2.3
    , base                  >=4.20   && <4.23
    , bytestring            >=0.12   && <0.13
    , Cabal-syntax          >=3.12   && <3.17
    , containers            >=0.6.8  && <0.9
    , crypton               >=2.0    && <2.3
    , directory             >=1.3.8  && <1.4
    , file-embed            >=0.0.16 && <0.1
    , filepath              >=1.5    && <1.6
    , http-types            >=0.12.4 && <0.13
    , network               >=3.2    && <3.3
    , optparse-applicative  >=0.18   && <0.20
    , process               >=1.6.19 && <1.7
    , ram                   >=0.21   && <0.23
    , stm                   >=2.5.1  && <2.6
    , text                  >=2.1    && <2.2
    , time                  >=1.12   && <1.16
    , unix                  >=2.8    && <2.9
    , wai                   >=3.2.4  && <3.3
    , warp                  >=3.4    && <3.5

executable haskell-reviewer
  import:         shared
  hs-source-dirs: app
  main-is:        Main.hs
  -- -rtsopts: the benchmark harness needs +RTS -t/--machine-readable to
  -- read memory stats (see haskell-reviewer-bench, D-85). This also
  -- means a user can pass +RTS options to the real binary.
  ghc-options:    -threaded -rtsopts
  build-depends:
    , base
    , haskell-reviewer

test-suite haskell-reviewer-test
  import:             shared
  type:               exitcode-stdio-1.0

  -- ../bench/src: the benchmark harness's pure modules, so they get
  -- unit tests too. Not ../bench/app: that's the harness's own IO code
  -- and has its own Main.hs, which would clash with this one.
  hs-source-dirs:     test ../bench/src
  main-is:            Main.hs
  other-modules:
    ApiSupport
    Bench.Projects
    Bench.ProjectsTest
    Bench.RtsStats
    Bench.RtsStatsTest
    Bench.Stats
    Bench.StatsTest
    ExeTest
    HaskellReviewer.App.CliTest
    HaskellReviewer.App.RunTest
    HaskellReviewer.Core.AddressTest
    HaskellReviewer.Core.CabalFileTest
    HaskellReviewer.Core.FileListTest
    HaskellReviewer.Core.GitTest
    HaskellReviewer.Core.PackageGlobTest
    HaskellReviewer.Core.ProjectFileTest
    HaskellReviewer.Core.ProjectGoldenTest
    HaskellReviewer.Core.ProjectLoadTest
    HaskellReviewer.Core.RelPathTest
    HaskellReviewer.Core.RootTest
    HaskellReviewer.Effects.FileSystemTest
    HaskellReviewer.Effects.GitTest
    HaskellReviewer.Effects.HelperTest
    HaskellReviewer.Effects.LogTest
    HaskellReviewer.Effects.SpawnTest
    HaskellReviewer.Effects.TraceTest
    HaskellReviewer.Server.ApiGoldenTest
    HaskellReviewer.Server.ApiTest
    HaskellReviewer.Server.AssetsTest
    HaskellReviewer.Server.EventsTest
    HaskellReviewer.Server.ListenTest
    HaskellReviewer.Server.RouterTest
    HaskellReviewer.Session.ClientsTest
    HaskellReviewer.Session.SnapshotTest
    ProjectDump
    TestSupport

  ghc-options:        -threaded
  build-tool-depends: haskell-reviewer:haskell-reviewer
  build-depends:
    , aeson
    , async
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , haskell-reviewer
    , http-types
    , network
    , process
    , tasty             >=1.5  && <1.6
    , tasty-golden      >=2.3  && <2.4
    , tasty-hunit       >=0.10 && <0.11
    , temporary         >=1.3  && <1.4
    , text
    , time
    , unix
    , wai
    , warp

-- The benchmark harness (SPEC §10, §11.9; D-76, D-85). Runs the product
-- binary against the pinned reference projects (bench/projects.txt,
-- D-82). `bench/src` is pure (also reachable from the test-suite, for
-- unit tests); `bench/app` runs processes and does IO, so it's only
-- reachable from here.
benchmark haskell-reviewer-bench
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: ../bench/app ../bench/src
  main-is:        Main.hs
  other-modules:
    Bench.Http
    Bench.Machine
    Bench.Projects
    Bench.Report
    Bench.RtsStats
    Bench.Run
    Bench.Stats

  ghc-options:    -threaded
  build-depends:
    , aeson
    , base
    , bytestring
    , directory
    , filepath
    , network
    , optparse-applicative
    , process
    , temporary
    , text
    , time
    , unix
