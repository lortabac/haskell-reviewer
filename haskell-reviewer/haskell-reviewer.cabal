cabal-version: 3.12
name:          haskell-reviewer
version:       0.1.0.0
synopsis:      Review Haskell code in the browser
license:       BSD-3-Clause
author:        Lorenzo Tabacchini
maintainer:    lortabac@gmail.com
copyright:     (c) 2026 Lorenzo Tabacchini
category:      Development
build-type:    Simple

common shared
  default-language:   GHC2024
  default-extensions:
    DuplicateRecordFields
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings

  ghc-options:
    -Wall -Wcompat -Wincomplete-record-updates -Wpartial-fields
    -Wredundant-constraints -Wunused-packages -Wmissing-export-lists

library
  import:          shared
  hs-source-dirs:  src

  -- Grouped by layer, lowest first. See Note [Layers] in
  -- HaskellReviewer.App.Run.
  exposed-modules:
    -- Core
    HaskellReviewer.Core.Root

    -- Effects
    HaskellReviewer.Effects.Clock
    HaskellReviewer.Effects.FileSystem
    HaskellReviewer.Effects.Log
    HaskellReviewer.Effects.Trace

    -- App
    HaskellReviewer.App.Cli
    HaskellReviewer.App.Run
    HaskellReviewer.App.Version

  autogen-modules: PackageInfo_haskell_reviewer
  other-modules:   PackageInfo_haskell_reviewer
  build-depends:
    , aeson                 >=2.2    && <2.4
    , base                  >=4.20   && <4.23
    , bytestring            >=0.12   && <0.13
    , directory             >=1.3.8  && <1.4
    , optparse-applicative  >=0.18   && <0.20
    , text                  >=2.1    && <2.2
    , time                  >=1.12   && <1.16

executable haskell-reviewer
  import:         shared
  hs-source-dirs: app
  main-is:        Main.hs
  ghc-options:    -threaded
  build-depends:
    , base
    , haskell-reviewer

test-suite haskell-reviewer-test
  import:             shared
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Main.hs
  other-modules:
    ExeTest
    HaskellReviewer.App.CliTest
    HaskellReviewer.App.RunTest
    HaskellReviewer.Effects.TraceTest

  ghc-options:        -threaded
  build-tool-depends: haskell-reviewer:haskell-reviewer
  build-depends:
    , aeson
    , base
    , bytestring
    , directory
    , filepath           >=1.5    && <1.6
    , haskell-reviewer
    , process            >=1.6.19 && <1.7
    , tasty              >=1.5    && <1.6
    , tasty-hunit        >=0.10   && <0.11
    , temporary          >=1.3    && <1.4
    , text
    , time
