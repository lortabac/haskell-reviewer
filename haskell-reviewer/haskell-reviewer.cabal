  -- -N: tasty >= 1.5.5 no longer turns it on by itself, and tests must
  -- run in parallel: that's what catches the RTS livelock
  -- (Q-RTS-BLACKHOLE) and races.
  ghc-options:        -threaded -rtsopts "-with-rtsopts=-N"
  build-tool-depends: haskell-reviewer:haskell-reviewer
  build-depends:
    , aeson
    , async
    , base
    , bytestring
    , cborg
    , containers
    , directory
    , filepath
    -- GHC's AST and collectors, as oracles for the occurrence table.
    , ghc-lib-parser
    , haskell-reviewer
    , http-types
    -- Test-only oracle for our port in Core.SourceText (D-224).
    , markdown-unlit    ==0.6.0
    , network
    , process
    , stm
    , hedgehog          >=1.7  && <1.8
    , tasty             >=1.5  && <1.6
    , tasty-hedgehog    >=1.4  && <1.5
    , tasty-expected-failure >=0.12 && <0.13
    , tasty-golden      >=2.3  && <2.4
    , tasty-hunit       >=0.10 && <0.11
    , temporary         >=1.3  && <1.4
    , text
    , time
    , unix
    , vector
    , wai
    , warp
    , zlib              >=0.7  && <0.8

-- The benchmark harness (SPEC §10, §11.9; D-76, D-85). Runs the product
-- binary against the pinned reference projects (bench/projects.txt,
-- D-82). `bench/src` is pure (also reachable from the test-suite, for
-- unit tests); `bench/app` runs processes and does IO, so it's only
-- reachable from here.
benchmark haskell-reviewer-bench
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: ../bench/app ../bench/src
  main-is:        Main.hs
  other-modules:
    Bench.DiffAnswer
    Bench.DiffFiles
    Bench.Fallbacks
    Bench.GcLog
    Bench.Http
    Bench.IndexLog
    Bench.Machine
    Bench.Mode
    Bench.ModuleList
    Bench.Path
    Bench.Projects
    Bench.Queries
    Bench.Refs
    Bench.RefsDuring
    Bench.Report
    Bench.Report.Json
    Bench.RtsStats
    Bench.Run
    Bench.SearchDuring
    Bench.Session
    Bench.Shell
    Bench.Startup
    Bench.Stats
    Bench.Steady
    Bench.Targets
    Bench.Url

  ghc-options:    -threaded
  -- haskell-reviewer: only for its CBOR to JSON code (module pages).
  build-depends:
    , aeson
    , async
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , haskell-reviewer
    , network
    , optparse-applicative
    , process
    , temporary
    , text
    , time
    , unix
    , zlib
